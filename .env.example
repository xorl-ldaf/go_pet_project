HTTP_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_NAME=todo_dev
DB_USER=todo
DB_PASSWORD=change-me-dev-db-password
DB_SSLMODE=disable

JWT_SECRET=change-me-dev-jwt-secret-at-least-32-bytes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

SCHEDULER_INTERVAL=5s
SCHEDULER_BATCH_SIZE=100
SCHEDULER_WORKERS=1

RECURRENCE_INTERVAL=5s
RECURRENCE_BATCH_SIZE=100

KAFKA_BROKERS=localhost:9092
KAFKA_PORT=9092
KAFKA_NOTIFICATION_TOPIC=notification.requested.v1
KAFKA_NOTIFICATION_CONSUMER_GROUP=todo-notifier-v1

OUTBOX_INTERVAL=2s
OUTBOX_BATCH_SIZE=25

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_RETRY_DELAYS=10s,1m,5m
TELEGRAM_DELIVERY_INTERVAL=5s
TELEGRAM_DELIVERY_BATCH_SIZE=25

METRICS_PORT=0
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
